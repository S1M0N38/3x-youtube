{
  "manifest_version": 2,
  "name": "3xYouTube",
  "version": "1.6",
  "description": "Increase YouTube playback speed up to 3x straight from the player settings menu.",
  "permissions": [
    "storage",
    "*://www.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "css": [
        "player.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/3xyt-16.png",
    "32": "icons/3xyt-32.png",
    "48": "icons/3xyt-48.png",
    "96": "icons/3xyt-96.png",
    "128": "icons/3xyt-128.png"
  },
  "commands": {
    "speed-up": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Increase playback speed"
    },
    "speed-down": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Decrease playback speed"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "3xyoutube@ipflux.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
